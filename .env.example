# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# PostgreSQL (Docker Compose service)
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=changeme
POSTGRES_DB=telemetry_db
DATABASE_URL=postgresql://telemetry:changeme@db:5432/telemetry_db

# AWS
# Authentication uses AWS IAM Identity Center (SSO) — no static keys.
# Run once to configure: aws configure sso
# Run to authenticate:   aws sso login --profile your-profile
# The CLI and boto3 pick up temporary credentials automatically.
AWS_REGION=us-west-2
AWS_PROFILE=your-sso-profile-name
