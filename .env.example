# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# PostgreSQL (Docker Compose service)
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=changeme
POSTGRES_DB=telemetry_db
# In-container URL — used by services on the compose network (api → db).
DATABASE_URL=postgresql://telemetry:changeme@db:5432/telemetry_db
# Host-side URL — used by tooling on the EC2 host (MCP server, psql, scripts).
# Postgres is bound to 127.0.0.1:5432 on the host (see ADR-002).
DATABASE_URL_LOCAL=postgresql://telemetry:changeme@127.0.0.1:5432/telemetry_db

# AWS
# No keys stored here. Credentials live in ~/.aws/credentials via:
#   aws configure --profile telemetry-dev
# boto3 and the CLI pick up the profile automatically via AWS_PROFILE.
AWS_REGION=us-west-2
AWS_PROFILE=telemetry-dev
